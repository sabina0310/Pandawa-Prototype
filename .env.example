# =====================================================================
# KONFIGURASI MIDTRANS - MODE SANDBOX (PENGUJIAN)
# =====================================================================
# Cara pakai:
# 1. Salin file ini dan ganti namanya menjadi ".env"
# 2. Isi nilai di bawah dengan key milik Anda sendiri
# 3. Ambil key di: https://dashboard.sandbox.midtrans.com
#    Menu: Settings > Access Keys
#
# PENTING: file ".env" berisi kunci rahasia dan sudah didaftarkan di
# .gitignore, jadi JANGAN PERNAH di-upload ke GitHub.
# =====================================================================

# Server Key - dipakai di sisi server (folder /api).
# Bersifat RAHASIA, tidak boleh muncul di kode HTML/JavaScript browser.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx

# Client Key - boleh dipakai di sisi browser.
# Belum digunakan pada alur QRIS Core API ini, disiapkan untuk
# pengembangan berikutnya (misalnya bila memakai Snap).
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx


# =====================================================================
# KONFIGURASI FONNTE - NOTIFIKASI WHATSAPP OTOMATIS
# =====================================================================
# Dipakai oleh:
#   api/cron-notifikasi-tenggat.js  (pengingat tenggat, 1x sehari)
#   api/cron-uji-notifikasi.js      (simulasi UAT, tiap 3 menit)
# =====================================================================

# Token Fonnte. Ambil di https://md.fonnte.com/
# Menu: Device > pilih perangkat > salin "Token"
# Bersifat RAHASIA. Jangan pernah ditulis langsung di dalam kode.
FONNTE_TOKEN=isi-token-fonnte-anda-di-sini

# ---------------------------------------------------------------------
# PENGAMAN: pengalih nomor tujuan (SANGAT DISARANKAN saat pengujian)
# ---------------------------------------------------------------------
# Data hasil seeding memakai nomor telepon ACAK yang formatnya valid,
# sehingga besar kemungkinan nomor itu milik orang lain yang tidak ada
# hubungannya dengan aplikasi ini.
#
# Selama variabel ini DIISI, seluruh pesan dialihkan ke nomor tersebut.
# Nomor tujuan aslinya tetap ditulis di isi pesan dan di log, sehingga
# bukti pengujian tetap sah.
#
# Variabel ini BERDIRI SENDIRI dari UAT_MODE. Mode uji yang menyala
# TIDAK dengan sendirinya mengalihkan nomor tujuan -- pengalihan hanya
# terjadi bila baris ini diisi.
#
# CARA MENGAKTIFKAN PENGIRIMAN KE NOMOR PENYEWA SUNGGUHAN:
# kosongkan atau hapus baris ini, lalu deploy ulang.
# Tidak ada baris kode yang perlu diubah.
FONNTE_NOMOR_UJI=6281234567890

# ---------------------------------------------------------------------
# Kunci pengaman endpoint cron (opsional)
# ---------------------------------------------------------------------
# Bila diisi, endpoint cron hanya bisa dipanggil dengan menyertakan
# header "Authorization: Bearer <nilai>" atau query "?secret=<nilai>".
# Vercel Cron mengirim header ini secara otomatis.
#
# Biarkan KOSONG selama pengembangan agar mudah diuji lewat browser.
# CRON_SECRET=


# =====================================================================
# MODE PENGUJIAN (UAT)
# =====================================================================
# Satu variabel ini mengatur DUA hal.
#
# ---------------------------------------------------------------------
# 1. PEMBUAT DATA UJI  (butuh nilai TEPAT "true")
# ---------------------------------------------------------------------
# Bila diisi "true", setiap pemesanan yang berhasil dapat diikuti
# pembuatan SATU data uji bertenggat H-7 memakai data diri yang sama.
# Data itu langsung terdeteksi cron notifikasi, sehingga pesan WhatsApp
# pengingat sampai dalam hitungan menit -- tanpa perlu menunggu tanggal
# jatuh tempo sungguhan.
#
#   api/uat-dummy-booking.js  (membuat data uji, order_id "UAT-...")
#   api/uat-bersihkan.js      (menghapus data uji & mengembalikan kamar)
#
# ---------------------------------------------------------------------
# 2. CAKUPAN CRON  (menyala kecuali diisi tegas "false")
# ---------------------------------------------------------------------
# Selama MENYALA, cron notifikasi hanya memproses pesanan ber-order_id
# "UAT-...". Seluruh pesanan biasa (PP-...) dan 50 data seeding
# dilewati tanpa dikirimi apa pun.
#
#   api/cron.js
#   api/cron-notifikasi-tenggat.js
#   api/cron-uji-notifikasi.js
#
# PENTING: variabel ini TIDAK mengubah nomor tujuan. Pesan tetap
# dikirim ke nomor penyewa yang tercatat pada pesanan itu. Untuk
# mengalihkannya, isi FONNTE_NOMOR_UJI di atas.
#
# ---------------------------------------------------------------------
# TABEL NILAI
# ---------------------------------------------------------------------
#   nilai            pembuat data uji   cakupan cron
#   ---------------  -----------------  --------------------------
#   true             aktif              hanya pesanan "UAT-"
#   false            mati               SELURUH pesanan
#   kosong           mati               hanya pesanan "UAT-"  (aman)
#   tidak diisi      mati               hanya pesanan "UAT-"  (aman)
#   salah ketik      mati               hanya pesanan "UAT-"  (aman)
#
# Perbedaan itu DISENGAJA. Saat nilainya meragukan, keduanya jatuh ke
# sisi yang lebih aman: tidak ada data uji baru dibuat, dan cron tidak
# menyentuh pesanan biasa. Lupa menyalakan berakibat seluruh transaksi
# ikut dikirimi pesan; lupa mematikan hanya berakibat pesanan biasa
# terlewat, dan itu langsung terlihat di log.
#
# ---------------------------------------------------------------------
# NOMOR TUJUAN SAAT MODE UJI MENYALA
# ---------------------------------------------------------------------
# Pesanan UAT dibuat dengan MENYALIN pesanan lain, termasuk nomornya.
# Jadi nomor tujuannya adalah nomor pesanan asal. Bila pesanan UAT
# dibuat dari data seeding, nomor itu acak dan bisa milik orang lain.
#
# Aman: buat pesanan UAT dari pesanan yang Anda buat sendiri lewat form
# pemesanan memakai nomor WhatsApp Anda -- atau isi FONNTE_NOMOR_UJI.
#
# UNTUK PRODUCTION: isi TEPAT "false" -- jangan dikosongkan, karena
# kosong justru membuat cakupan tetap terbatas pada pesanan "UAT-".
UAT_MODE=true
