# =====================================================================
# KONFIGURASI MIDTRANS - MODE SANDBOX (PENGUJIAN)
# =====================================================================
# Cara pakai:
# 1. Salin file ini dan ganti namanya menjadi ".env"
# 2. Isi nilai di bawah dengan key milik Anda sendiri
# 3. Ambil key di: https://dashboard.sandbox.midtrans.com
#    Menu: Settings > Access Keys
#
# PENTING: file ".env" berisi kunci rahasia dan sudah didaftarkan di
# .gitignore, jadi JANGAN PERNAH di-upload ke GitHub.
# =====================================================================

# Server Key - dipakai di sisi server (folder /api).
# Bersifat RAHASIA, tidak boleh muncul di kode HTML/JavaScript browser.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx

# Client Key - boleh dipakai di sisi browser.
# Belum digunakan pada alur QRIS Core API ini, disiapkan untuk
# pengembangan berikutnya (misalnya bila memakai Snap).
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx


# =====================================================================
# KONFIGURASI FONNTE - NOTIFIKASI WHATSAPP OTOMATIS
# =====================================================================
# Dipakai oleh:
#   api/cron-notifikasi-tenggat.js  (pengingat tenggat, 1x sehari)
#   api/cron-uji-notifikasi.js      (simulasi UAT, tiap 3 menit)
# =====================================================================

# Token Fonnte. Ambil di https://md.fonnte.com/
# Menu: Device > pilih perangkat > salin "Token"
# Bersifat RAHASIA. Jangan pernah ditulis langsung di dalam kode.
FONNTE_TOKEN=isi-token-fonnte-anda-di-sini

# ---------------------------------------------------------------------
# PENGAMAN: pengalih nomor tujuan (SANGAT DISARANKAN saat pengujian)
# ---------------------------------------------------------------------
# Data hasil seeding memakai nomor telepon ACAK yang formatnya valid,
# sehingga besar kemungkinan nomor itu milik orang lain yang tidak ada
# hubungannya dengan aplikasi ini.
#
# Selama variabel ini DIISI, seluruh pesan dialihkan ke nomor tersebut.
# Nomor tujuan aslinya tetap ditulis di isi pesan dan di log, sehingga
# bukti pengujian tetap sah.
#
# CARA MENGAKTIFKAN PENGIRIMAN KE NOMOR PENYEWA SUNGGUHAN:
# kosongkan atau hapus baris ini, lalu deploy ulang.
# Tidak ada baris kode yang perlu diubah.
FONNTE_NOMOR_UJI=6281234567890

# ---------------------------------------------------------------------
# Kunci pengaman endpoint cron (opsional)
# ---------------------------------------------------------------------
# Bila diisi, endpoint cron hanya bisa dipanggil dengan menyertakan
# header "Authorization: Bearer <nilai>" atau query "?secret=<nilai>".
# Vercel Cron mengirim header ini secara otomatis.
#
# Biarkan KOSONG selama pengembangan agar mudah diuji lewat browser.
# CRON_SECRET=
